{
  "compilerOptions": {
    // Boolean flags
    "pretty": true,
    "sourceMap": true,
    "importHelpers": true,
    "removeComments": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "experimentalDecorators": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,
    // Other
    "jsx": "preserve",
    "lib": [
      "ESNext",
      "DOM"
    ],
    // Starting from v6, all @types packages in package.json must be added
    // here explicitly, as this field defaults to []. If we want to keep
    // the old behaviour, set this field to ["*"].
    "types": [
      "vitest/globals",
      "dotenv-safe",
      "node"
    ]
  },
  // https://v3.nuxtjs.org/concepts/typescript
  "extends": "./.nuxt/tsconfig.json"
}
